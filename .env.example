# Copy to .env and fill in. .env is gitignored. Never commit real keys.

# shadow | demo | live. Default is shadow.
MODE=shadow

# Live trading needs ALL of: MODE=live, this exact value, and a fresh gate1_passed.json.
LIVE_TRADING_CONFIRMED=
GATE_FILE=gate1_passed.json
GATE_MAX_AGE_DAYS=30

DATABASE_URL=postgresql+psycopg://kalshi:kalshi@127.0.0.1:5432/kalshi

# Base URLs come from Kalshi's OpenAPI spec (docs/vendor/kalshi_openapi.yaml).
KALSHI_PROD_BASE_URL=https://external-api.kalshi.com/trade-api/v2
KALSHI_DEMO_BASE_URL=https://external-api.demo.kalshi.co/trade-api/v2

# Demo and production use SEPARATE keys. Key files live outside the repo or are gitignored (*.pem).
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=
KALSHI_PROD_KEY_ID=
KALSHI_PROD_PRIVATE_KEY_PATH=

# Used only by the rules parser (milestone 3).
ANTHROPIC_API_KEY=

STARTING_BANKROLL=100
MIN_EDGE=0.03
MAX_POSITION_PCT=0.05
MAX_TOTAL_EXPOSURE_PCT=0.25
MAX_PER_EVENT_PCT=0.10
KILL_SWITCH_DRAWDOWN_PCT=0.30
